<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="autobots_roundtrip">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
    <scene>
      <grid>false</grid>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.32 0.42 0.52 1</background>
      <shadows>true</shadows>
    </scene>
    <!-- Explicit world plugins disable Gazebo's implicit defaults. PX4 needs all four sensor systems. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <light name="sun" type="directional">
      <pose>0 0 30 0.35 -0.65 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.2</intensity>
      <direction>-0.35 0.15 -1</direction>
    </light>
    <!-- Gazebo Fuel assets are downloaded once and then cached. -->
    <include><uri>https://fuel.ignitionrobotics.org/1.0/hexarotor/models/grasspatch</uri><name>grass_center</name><pose>0 0 0 0 0 0</pose></include>
    <include><uri>https://fuel.ignitionrobotics.org/1.0/hexarotor/models/grasspatch</uri><name>grass_north</name><pose>0 15 0 0 0 0.15</pose></include>
    <include><uri>https://fuel.ignitionrobotics.org/1.0/hexarotor/models/grasspatch</uri><name>grass_south</name><pose>0 -15 0 0 0 -0.1</pose></include>
    <include><uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Oak Tree</uri><name>oak_east</name><pose>8 6 0 0 0 0.3</pose></include>
    <include><uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Pine Tree</uri><name>pine_east</name><pose>8 -6 0 0 0 0</pose></include>
    <include><uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Oak Tree</uri><name>oak_west</name><pose>-8 7 0 0 0 -0.2</pose></include>
    <include><uri>https://fuel.ignitionrobotics.org/1.0/OpenRobotics/models/Pine Tree</uri><name>pine_west</name><pose>-8 -7 0 0 0 0.2</pose></include>
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry><material><ambient>0.12 0.18 0.12 1</ambient><diffuse>0.18 0.28 0.16 1</diffuse></material></visual>
      </link>
    </model>
    <model name="landing_pad">
      <static>true</static><pose>0 0 0.03 0 0 0</pose>
      <link name="link">
        <visual name="pad"><geometry><cylinder><radius>2.2</radius><length>0.06</length></cylinder></geometry><material><ambient>0.08 0.10 0.12 1</ambient><diffuse>0.12 0.15 0.18 1</diffuse></material></visual>
        <visual name="ring"><pose>0 0 0.04 0 0 0</pose><geometry><cylinder><radius>1.8</radius><length>0.02</length></cylinder></geometry><material><ambient>0.9 0.65 0.05 1</ambient><diffuse>1 0.75 0.05 1</diffuse></material></visual>
      </link>
    </model>
    <model name="destination_B">
      <static>true</static><pose>7 0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="marker"><geometry><cylinder><radius>1.2</radius><length>0.04</length></cylinder></geometry><material><ambient>0.02 0.25 0.75 1</ambient><diffuse>0.04 0.42 0.95 1</diffuse></material></visual>
      </link>
    </model>
    <model name="overview_camera">
      <static>true</static><pose>4 -9 6 0 0.40 1.57</pose>
      <link name="camera_link">
        <sensor name="overview" type="camera">
          <camera><horizontal_fov>1.30</horizontal_fov><image><width>1280</width><height>720</height></image><clip><near>0.1</near><far>100</far></clip></camera>
          <always_on>1</always_on><update_rate>30</update_rate>
        </sensor>
      </link>
    </model>
    <model name="pad_camera">
      <static>true</static><pose>0 -6 4.5 0 0.48 1.57</pose>
      <link name="camera_link">
        <sensor name="pad" type="camera">
          <camera><horizontal_fov>1.1</horizontal_fov><image><width>1280</width><height>720</height></image><clip><near>0.1</near><far>100</far></clip></camera>
          <always_on>1</always_on><update_rate>25</update_rate>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
